#!/usr/bin/env python3

import argparse
import base64
import hashlib
import hmac
import json
import os
import sys
import time
import uuid
from pathlib import Path
from urllib.parse import quote


CREDS_FILE = Path("/etc/jitsi-invite/jwt.env")


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}

    if not path.is_file():
        raise RuntimeError(f"Credential file not found: {path}")

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()

        if not line or line.startswith("#"):
            continue

        if "=" not in line:
            raise RuntimeError(f"Invalid line in {path}: {raw_line!r}")

        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()

    required = {
        "JITSI_APP_ID",
        "JITSI_APP_SECRET",
        "JITSI_DOMAIN",
    }

    missing = sorted(required - values.keys())

    if missing:
        raise RuntimeError(
            "Missing credential values: " + ", ".join(missing)
        )

    return values


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


def encode_jwt(payload: dict, secret: str) -> str:
    header = {
        "alg": "HS256",
        "typ": "JWT",
    }

    header_part = b64url(
        json.dumps(
            header,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
    )

    payload_part = b64url(
        json.dumps(
            payload,
            separators=(",", ":"),
            ensure_ascii=False,
        ).encode("utf-8")
    )

    signing_input = f"{header_part}.{payload_part}".encode("ascii")

    signature = hmac.new(
        secret.encode("utf-8"),
        signing_input,
        hashlib.sha256,
    ).digest()

    return f"{header_part}.{payload_part}.{b64url(signature)}"


def normalize_room(value: str) -> str:
    room = value.strip().lower()

    if not room:
        raise ValueError("Room name must not be empty")

    allowed = set(
        "abcdefghijklmnopqrstuvwxyz"
        "0123456789"
        "-_"
    )

    if any(char not in allowed for char in room):
        raise ValueError(
            "Room may contain only a-z, 0-9, hyphen and underscore"
        )

    return room


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate a room-bound Jitsi JWT URL"
    )

    parser.add_argument(
        "room",
        help="Room name",
    )

    parser.add_argument(
        "--name",
        default="JWT Test Moderator",
        help="Displayed participant name",
    )

    parser.add_argument(
        "--role",
        choices=("moderator", "guest"),
        default="guest",
        help="Participant role; default: guest",
    )

    parser.add_argument(
        "--ttl",
        type=int,
        default=3600,
        help="Token lifetime in seconds",
    )

    args = parser.parse_args()

    if args.ttl < 60 or args.ttl > 86400:
        parser.error("--ttl must be between 60 and 86400 seconds")

    try:
        creds = read_env(CREDS_FILE)
        room = normalize_room(args.room)
    except (RuntimeError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    now = int(time.time())
    user_id = str(uuid.uuid4())

    payload = {
        "iss": creds["JITSI_APP_ID"],
        "aud": creds["JITSI_APP_ID"],
        "sub": creds["JITSI_DOMAIN"],
        "room": room,
        "iat": now,
        "nbf": now - 10,
        "exp": now + args.ttl,
        "jti": str(uuid.uuid4()),
        "context": {
            "user": {
                "id": user_id,
                "name": args.name,
                "moderator": args.role == "moderator",
            }
        },
    }

    token = encode_jwt(
        payload,
        creds["JITSI_APP_SECRET"],
    )

    domain = creds["JITSI_DOMAIN"]
    url = f"https://{domain}/{quote(room)}?jwt={token}"

    print(url)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
