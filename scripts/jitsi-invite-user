#!/bin/bash
set -euo pipefail
umask 077

AUTH_FILE="${JITSI_INVITE_AUTH_FILE:-/etc/nginx/jitsi-invite.htpasswd}"
AUTH_OWNER="${JITSI_INVITE_AUTH_OWNER:-root}"
AUTH_GROUP="${JITSI_INVITE_AUTH_GROUP:-www-data}"
AUTH_READER="${JITSI_INVITE_AUTH_READER:-www-data}"
NGINX_BIN="${JITSI_INVITE_NGINX_BIN:-nginx}"
SYSTEMCTL_BIN="${JITSI_INVITE_SYSTEMCTL_BIN:-systemctl}"

usage() {
    echo "Usage:"
    echo "  jitsi-invite-user list"
    echo "  jitsi-invite-user add USERNAME"
    echo "  jitsi-invite-user delete USERNAME"
    exit 2
}

validate_username() {
    local username="$1"

    case "$username" in
        (*[!A-Za-z0-9._-]*|'')
            echo \
                "ERROR: username may contain only A-Z, a-z, 0-9, dot, underscore and hyphen"
            exit 1
            ;;
    esac
}

apply_auth_metadata() {
    local path="$1"

    if [ "$(id -u)" -eq 0 ]; then
        chown "${AUTH_OWNER}:${AUTH_GROUP}" "$path"
    else
        if [ "$AUTH_OWNER" != "$(id -un)" ] \
            || [ "$AUTH_GROUP" != "$(id -gn)" ]; then
            echo \
                "ERROR: non-root execution requires current owner and group"
            return 1
        fi
    fi

    chmod 0640 "$path"
}

verify_reader_access() {
    local path="$1"

    if [ "$AUTH_READER" = "$(id -un)" ]; then
        test -r "$path"
    else
        runuser -u "$AUTH_READER" -- test -r "$path"
    fi
}

command="${1:-}"

case "$command" in
    list)
        if [ ! -s "$AUTH_FILE" ]; then
            echo "No portal users."
            exit 0
        fi

        cut -d: -f1 "$AUTH_FILE"
        ;;

    add)
        username="${2:-}"
        validate_username "$username"

        echo \
            "WARNING: password input is intentionally visible in this terminal."

        IFS= read -r -p \
            "New Jitsi Invite password for ${username}: " \
            password

        IFS= read -r -p \
            "Repeat Jitsi Invite password for ${username}: " \
            password_confirmation

        if [ -z "$password" ]; then
            unset password password_confirmation
            echo "ERROR: empty password"
            exit 1
        fi

        if [ "$password" != "$password_confirmation" ]; then
            unset password password_confirmation
            echo "ERROR: passwords do not match"
            exit 1
        fi

        unset password_confirmation

        password_hash="$(
            printf '%s' "$password" |
            openssl passwd -apr1 -stdin
        )"

        temporary_file="$(
            mktemp "${AUTH_FILE}.XXXXXX"
        )"

        trap 'rm -f "$temporary_file"' EXIT

        if [ -f "$AUTH_FILE" ]; then
            awk -F: -v username="$username" '
                $1 != username
            ' "$AUTH_FILE" >"$temporary_file"
        fi

        printf '%s:%s\n' \
            "$username" \
            "$password_hash" \
            >>"$temporary_file"

        apply_auth_metadata "$temporary_file"
        verify_reader_access "$temporary_file"

        mv -f "$temporary_file" "$AUTH_FILE"
        trap - EXIT

        # The account file has already been updated at this point. Print the
        # assigned credentials before nginx operations so that the operator
        # does not lose them if validation or reload fails.
        printf "Assigned plaintext password for '%s': %s\n" \
            "$username" \
            "$password"

        printf "APR1 hash for '%s': %s\n" \
            "$username" \
            "$password_hash"

        unset password password_hash

        if ! "$NGINX_BIN" -t; then
            echo \
                "ERROR: account file was updated, but nginx configuration validation failed." \
                >&2
            exit 1
        fi

        if ! "$SYSTEMCTL_BIN" reload nginx; then
            echo \
                "ERROR: account file was updated, but nginx reload failed." \
                >&2
            exit 1
        fi

        echo "Portal user '${username}' created or updated."
        ;;

    delete)
        username="${2:-}"
        validate_username "$username"

        if [ ! -f "$AUTH_FILE" ]; then
            echo "ERROR: authentication file does not exist"
            exit 1
        fi

        if ! awk -F: -v username="$username" '
            $1 == username {
                found=1
            }
            END {
                exit(found ? 0 : 1)
            }
        ' "$AUTH_FILE"; then
            echo "ERROR: user '${username}' does not exist"
            exit 1
        fi

        temporary_file="$(
            mktemp "${AUTH_FILE}.XXXXXX"
        )"

        trap 'rm -f "$temporary_file"' EXIT

        awk -F: -v username="$username" '
            $1 != username
        ' "$AUTH_FILE" >"$temporary_file"

        apply_auth_metadata "$temporary_file"
        verify_reader_access "$temporary_file"

        mv -f "$temporary_file" "$AUTH_FILE"
        trap - EXIT

        if ! "$NGINX_BIN" -t; then
            echo \
                "ERROR: account file was updated, but nginx configuration validation failed." \
                >&2
            exit 1
        fi

        if ! "$SYSTEMCTL_BIN" reload nginx; then
            echo \
                "ERROR: account file was updated, but nginx reload failed." \
                >&2
            exit 1
        fi

        echo "Portal user '${username}' deleted."
        ;;

    *)
        usage
        ;;
esac
