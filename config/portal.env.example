# Public base URL of the Jitsi Meet installation.
JITSI_INVITE_BASE_URL=https://meet.example.com

# SQLite database used for invitations and audit events.
JITSI_INVITE_DB=/var/lib/jitsi-invite/invite.db

# Secret used to authenticate portal form submissions.
# Example generation command:
#   openssl rand -hex 32
JITSI_INVITE_CSRF_SECRET=replace-with-64-random-hex-characters

# Lifetime of generated guest JWTs in seconds.
JITSI_INVITE_GUEST_TOKEN_TTL=14400

# Lifetime of generated moderator JWTs in seconds.
JITSI_INVITE_MODERATOR_TOKEN_TTL=28800

# Optional. The default already matches the systemd/nginx configuration.
# JITSI_INVITE_SOCKET=/run/jitsi-invite/jitsi-invite.sock
