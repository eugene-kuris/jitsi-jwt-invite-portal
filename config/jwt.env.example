# Jitsi JWT application identifier.
# Must match app_id in the Prosody VirtualHost configuration.
JITSI_APP_ID=replace-me

# Shared HS256 signing secret.
# This value must exactly match the active Prosody app_secret.
# Reuse the existing secret on an already configured strict-JWT host.
# Generate a new value only when configuring or rotating Prosody at
# the same time. Keep the real file readable only by root and the
# jitsi-invite service account.
JITSI_APP_SECRET=replace-with-a-long-random-secret

# Public Jitsi Meet domain without scheme or path.
JITSI_DOMAIN=meet.example.com
